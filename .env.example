PORT=10000
PUBLIC_BASE_URL=https://SEU-SERVICO.onrender.com

# Segurança do bridge/MCP. Use valores longos e aleatórios.
API_TOKEN=
MCP_LOGIN_SECRET=
QR_SECRET=

# WhatsApp/Baileys
BAILEYS_AUTH_PATH=/tmp/baileys_auth
WHATSAPP_DB_PATH=/tmp/whatsapp.sqlite
AUTO_REPLY_STATE_PATH=/tmp/whatsapp-auto-reply.json
BAILEYS_LOG_LEVEL=silent

# Supabase (backend only: nunca exponha service_role no navegador)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_BACKUP_INTERVAL_MS=120000

# IA: auto | groq | gemini | nvidia
AI_PROVIDER=auto
AI_TEMPERATURE=0.82

GROQ_API_KEY=
GROQ_REPLY_MODEL=openai/gpt-oss-20b
GROQ_REPLY_MAX_TOKENS=1024
GROQ_REPLY_TIMEOUT_MS=6000

GEMINI_API_KEY=
GEMINI_REPLY_MODEL=gemini-3.5-flash-lite
GEMINI_REPLY_TIMEOUT_MS=8000

NVIDIA_API_KEY=
NVIDIA_REPLY_MODEL=openai/gpt-oss-20b
NVIDIA_REPLY_TIMEOUT_MS=10000

# Controle e comportamento do auto reply
AUTO_REPLY_CONTROL_JID=
AUTO_REPLY_CONTROL_NUMBER=
AUTO_REPLY_DELAY_MIN_MS=250
AUTO_REPLY_DELAY_MAX_MS=750
AUTO_REPLY_DEBOUNCE_MS=350
AUTO_REPLY_CONCURRENCY=4
AUTO_REPLY_INTERPART_MIN_MS=150
AUTO_REPLY_INTERPART_MAX_MS=350
AUTO_REPLY_PREFIX=
AUTO_REPLY_STYLE=
