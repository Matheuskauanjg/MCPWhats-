PORT=10000
PUBLIC_BASE_URL=https://mcpwhats-personal.onrender.com

# Segurança do bridge/MCP.
API_TOKEN=
MCP_LOGIN_SECRET=
QR_SECRET=

# WhatsApp/Baileys
BAILEYS_AUTH_PATH=/tmp/baileys_auth
WHATSAPP_DB_PATH=/tmp/whatsapp.sqlite
AUTO_REPLY_STATE_PATH=/tmp/whatsapp-auto-reply.json
BAILEYS_LOG_LEVEL=silent
PERSISTENCE_BACKUP_INTERVAL_MS=120000

# Proteções de memória para Render Free.
WHATSAPP_SYNC_FULL_HISTORY=false
WHATSAPP_MEMORY_MESSAGES_PER_CHAT=40
WHATSAPP_MEMORY_CHAT_BUCKETS=120

# Espelhamento remoto com backpressure.
REMOTE_MIRROR_CONCURRENCY=2
REMOTE_MIRROR_MAX_QUEUE=400
REMOTE_MIRROR_RETRIES=2
REMOTE_HYDRATE_CHATS=500
REMOTE_HYDRATE_CONTACTS=1500
REMOTE_HYDRATE_MESSAGES=1500
REMOTE_HYDRATE_MAPPINGS=2000
MAX_REMOTE_RAW_MESSAGE_BYTES=32768

# Supabase compartilhado.
# MCPWhats usa apenas recursos mcpwhats_* e uma Edge Function de storage própria.
SUPABASE_URL=

# Modo recomendado para um projeto compartilhado:
# segredo exclusivo do MCPWhats usado no header x-mcpwhats-sync-secret.
MCPWHATS_SYNC_SECRET=

# Alternativa opcional: acesso direto administrativo.
# Não é necessário no deploy atual e nunca deve ir para frontend/GitHub.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_BACKUP_INTERVAL_MS=120000

# PostgreSQL opcional/fallback.
DATABASE_URL=

# IA: auto | groq | gemini | nvidia
AI_PROVIDER=auto
AI_TEMPERATURE=0.82

GROQ_API_KEY=
GROQ_REPLY_MODEL=openai/gpt-oss-20b
GROQ_REPLY_MAX_TOKENS=1024
GROQ_REPLY_TIMEOUT_MS=6000

GEMINI_API_KEY=
GEMINI_REPLY_MODEL=gemini-3.5-flash-lite
GEMINI_REPLY_TIMEOUT_MS=8000

NVIDIA_API_KEY=
NVIDIA_REPLY_MODEL=openai/gpt-oss-20b
NVIDIA_REPLY_TIMEOUT_MS=10000

AUTO_REPLY_CONTROL_JID=
AUTO_REPLY_CONTROL_NUMBER=
AUTO_REPLY_DELAY_MIN_MS=250
AUTO_REPLY_DELAY_MAX_MS=750
AUTO_REPLY_DEBOUNCE_MS=350
AUTO_REPLY_CONCURRENCY=4
AUTO_REPLY_INTERPART_MIN_MS=150
AUTO_REPLY_INTERPART_MAX_MS=350
AUTO_REPLY_PREFIX=
AUTO_REPLY_STYLE=
